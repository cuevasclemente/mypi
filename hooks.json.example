{
  "hooks": [
    {
      "name": "session-end-checklist",
      "trigger": "session_start",
      "todos": [
        {
          "text": "End of session: Journal the results unless this was only a quick change, simple answer, or mechanical data transformation.",
          "priority": "medium",
          "assignee": "session-end-checklist",
          "notes": "Journal when machine configuration changed, pi context was installed/modified, or development progress was made. For development work, create/use a project journal (for example docs/journals/). Use Memoriki/MemPalace for durable personal/tooling knowledge. If both project context and durable personal/tooling knowledge were created, journal in both places and report the path/entry id."
        },
        {
          "text": "End of session: Release any active session_coordination claims/locks that are no longer needed.",
          "priority": "medium",
          "assignee": "session-end-checklist",
          "notes": "Use session_coordination status to review claims owned by this session, then session_coordination release for completed or abandoned path/task claims. Leave only intentionally persistent claims with a note."
        }
      ]
    }
  ]
}
